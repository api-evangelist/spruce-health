            "url": "https://api.sprucehealth.com/v1/contacts/{contactId}/integrationlinks",
            "params": [
              {
                "name": "contactId",
                "value": "",
                "type": "path"
              },
              {
                "name": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "header"
              }
            ]
          },
          "operationId": "ContactIntegrationLinks",
          "docs": "This operation retrieves the integration links associated with a contact"
        },
        {
          "info": {
            "name": "Create an integration link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.sprucehealth.com/v1/contacts/{contactId}/integrationlinks",
            "params": [
              {
                "name": "s-idempotency-key",
                "value": "",
