                "value": "",
                "type": "query"
              },
              {
                "name": "externalId",
                "value": "",
                "type": "query"
              },
              {
                "name": "Authorization",
                "value": "Bearer {{bearerToken}}",
                "type": "header"
              }
            ]
          },
          "operationId": "DeleteContactIntegrationLink",
          "docs": "This operation deletes a specific integration link associated with a contact."
        },
        {
